# Auth0 env (copy to .env from this template)
# Get these from: https://auth0.com/docs/get-started/quickstart/spa

APP_PORT=8000

# Auth0 (Free tenant)
AUTH0_DOMAIN=          # e.g., dev-to-hacktober.auth0.com
AUTH0_CLIENT_ID=       # from SPA app
AUTH0_CLIENT_SECRET=   # from SPA app
AUTH0_AUDIENCE=https://intentlock-api
AUTH0_ALGORITHMS=RS256

# Token Vault connection (Google/Gmail, Testing mode)
TOKEN_VAULT_CONNECTION=google-oauth2
# scopes requested (never gmail.send)
GMAIL_SCOPES=gmail.read,gmail.compose

# Auth0 FGA
FGA_API_URL=https://api.us1.fga.dev
FGA_STORE_ID=          # create in FGA dashboard
FGA_MODEL_ID=          # create authorization model in FGA
FGA_CLIENT_ID=         # from FGA API credentials
FGA_CLIENT_SECRET=     # from FGA API credentials
FGA_API_TOKEN_ISSUER=auth.fga.dev
FGA_API_AUDIENCE=https://api.us1.fga.dev/

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_FALLBACK=gemma2:2b-it

# DB
DATABASE_PATH=./intentlock.db

# Flags
MOCK_LLM=0
MOCK_CONNECTORS=0